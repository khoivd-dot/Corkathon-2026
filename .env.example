# Copy to .env and fill locally. Never commit real values.
# Most Irish open data (CSO PxStat, data.gov.ie CKAN) needs no key.
CSO_API_BASE=https://ws.cso.ie/public/api.restful
DATA_GOV_IE_API_BASE=https://data.gov.ie/api/3
# Optional, only if an LLM is used for plain-language answers (off by default):
LLM_ENABLED=false
LLM_API_KEY=
# Source loaders (all keyless). SNAPSHOT=1 reads data/snapshots/<source>/ only, no network.
SNAPSHOT=0
# Optional: pin a snapshot day, e.g. 2026-11-07
SNAPSHOT_DATE=
SOURCE_TIMEOUT_S=20
# Optional: live ship position by MMSI (aisstream.io). Free key: sign in with GitHub at
# https://aisstream.io, open "API Keys", create one. Off until its display terms are confirmed.
AIS_LIVE_ENABLED=0
AISSTREAM_API_KEY=
AIS_LIVE_WAIT_S=25
